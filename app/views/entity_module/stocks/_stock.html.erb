<tr id="<%= dom_id stock %>">
  <td><%= badge_move_type(stock.move_type) %></td>
  <td><%= stock.quantity %></td>
  <td><%= humanized_money_with_symbol stock.cost_unit %></td>
  <td><%= humanized_money_with_symbol stock.total_cost %></td>
  <td><%= stock.product.name %></td>
  <td><%= I18n.l stock.created_at, format: :simple %></td>
  <td>
    <%= render 'actions', stock: stock %>
  </td>
</tr>
