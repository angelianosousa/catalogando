<%= form_with(model: [:entity, @stock]) do |form| %>

  <div class='card'>
    <div class='card-body'>
      <%= render 'shared/errors_messages', resource: @stock %>

      <div class="row">
        
        <div class="col-md">
          <div class='form-group'>
            <%= form.label :product_id, class: 'form-label' %>
            <%= form.select :product_id, options_for_select(products_for_select), {}, { class: 'form-select' } %>
          </div>
        </div>
      </div>

      <div class='row'>
        <div class="col-md">
          <div class="form-group">
            <%= form.label :cost_unit, clas: 'form-label' %>

            <div class="input-group mb-3">
              <span class="input-group-text">R$</span>
              <%= form.text_field :cost_unit, class: 'form-control' %>
              <span class="input-group-text">.00</span>
            </div>
          </div>
        </div>

        <div class="col-md">
          <div class="form-group">
            <%= form.label :quantity, clas: 'form-label' %>
            <%= form.text_field :quantity, class: 'form-control' %>
          </div>
        </div>
      </div>

      <div>
        <%= form.submit t('save'), class: 'btn btn-primary btn-sm' %>
      </div>
    </div>
  </div>
<% end %>
