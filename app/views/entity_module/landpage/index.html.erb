<div class="container-fluid text-bg-dark">
  <header class="d-flex flex-wrap justify-content-center py-3 mb-4 border-bottom" data-bs-theme="dark">
    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none">
      <svg class="bi me-2" width="40" height="32"><use xlink:href="#bootstrap"/></svg>
      <span class="fs-4"><%= @entity.name %></span>
    </a>

    <ul class="nav nav-pills">
      <li class="nav-item"><a href="#home" class="nav-link" aria-current="page">Home</a></li>
      <li class="nav-item"><a href="#products" class="nav-link" aria-current="page">Produtos</a></li>
    </ul>
  </header>
</div>


<section class="py-5 text-center container bg-body-secondary mb-3">
  <div class="row py-lg-5">
    <div class="col-lg-6 col-md-8 mx-auto">
      <h1 class="fw-light"><%= @entity.name %></h1>
      <p class="lead text-body-secondary">Something short and leading about the collection below—its contents, the creator, etc. Make it short and sweet, but not too short so folks don’t simply skip over it entirely.</p>
    </div>
  </div>
</section>


<div class="container-fluid">

  <div class="row">
    <div class="col-md-2 col-sm-12">
      <div class="navbar navbar-expand-lg">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#list-categories-products" aria-controls="list-categories-products" aria-expanded="false" aria-label="Toggle navigation">
          <span class="icon">
            <%= fa_icon 'list', text: 'Categorias' %>
          </span>
        </button>

        <div id="list-categories-products" class="list-group collapse navbar-collapse mt-3">
          <%= link_to "Todos", landpage_path, class: "list-group-item list-group-item-action #{params.dig('q', 'id_eq') == nil ? 'active' : ''}" %>

          <% @entity.categories.with_available_products.order(name: :asc).each do |cat| %>
            <%= link_to cat.name, landpage_path(q: { id_eq: cat.id }), class: "list-group-item list-group-item-action #{params.dig('q', 'id_eq').to_i == cat.id ? 'active' : ''}" %>
          <% end %>
        </div>
      </div>
    </div>
    

    <div class="col-md-10 col-sm-12">
      <%= render 'search_filter' %>

      <div style='height: 800px; overflow-y: scroll;'>
        <% @categories.each do |category| %>
          <h2 class='my-3' id="<%= landpage_path(q: { id_eq: category.id }) %>"><%= category.name %></h2>

          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-5 g-3">
            <%= render partial: 'product_list', locals: { products: category.products } %>
          </div>
        <% end %>

      </div>
      
    </div>
  </div>
</div>
