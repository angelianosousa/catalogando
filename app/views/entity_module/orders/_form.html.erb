<%= form_with(model: [:entity, order]) do |form| %>
  <div class='card'>
    <div class='card-body'>
      <%= render 'shared/errors_messages', resource: order %>

      <div class="form-group">
        <%= link_to_add_nested(form, :order_items, '#order-items', link_classes: 'btn btn-success') do %> 
          <i class='fa fa-plus'></i>
        <% end %>
      </div>

      <div id='order-items'>
        <%= form.fields_for :order_items do |order_item_f| %>
          <%= render 'order_item_fields', form: order_item_f %>
        <% end %>
      </div>

      <div class="form-group">
        <%= form.submit t('save'), class: 'btn btn-primary btn-sm' %>
      </div>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener('vanilla-nested:fields-added', function(e){
    console.log(e)
    // e.type == 'vanilla-nested:fields-added'
    // e.target == container div of the fields
    // e.detail.triggeredBy == the "add" link
    // e.detail.added == the fields wrapper just inserted
  })
</script>