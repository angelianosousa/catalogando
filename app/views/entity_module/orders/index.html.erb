<% content_for :title, "Catalogando | Pedidos" %>

<nav class="navbar bg-body-tertiary">
  <%= content_for :page_header do %>
    <div class="container-fluid d-flex justify-content-between">
      <h1>
        <%= fa_icon "list" %>
        <%= link_to 'Pedidos', entity_orders_path, class: 'navbar-brand text-dark' %>
      </h1>

      <%= link_to_new_resource("Lançar pedido", new_entity_order_path) %>
    </div>
  <% end %>
</nav>


<div class="card">
  <div class="card-body">
    <table class="table table-head-bg-black table-striped">
      <thead class='table-dark'>
        <tr>
          <th><%= Order.human_attribute_name :id %></th>
          <th><%= Order.human_attribute_name :created_at %></th>
          <th><%= Order.human_attribute_name :total_value %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <%= render order %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
