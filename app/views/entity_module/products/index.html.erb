<% content_for :title, "Catalogando | Produtos" %>

<nav class="navbar bg-body-tertiary">
  <%= content_for :page_header do %>
    <div class="container-fluid d-flex justify-content-between">
      <h1>
        <%= fa_icon "list" %>
        <%= link_to 'Produtos', entity_products_path, class: 'navbar-brand text-dark' %>
      </h1>

      <%= link_to_new_resource("Novo produto", new_entity_product_path) %>
    </div>
  <% end %>
</nav>


<div class="card border-dark">
  <div class="card-body">
    <%= search_form_for @q, url: entity_products_path, class: 'form' do |f| %>
      <div class="d-flex justify-content-left align-items-center">
        <div class="form-group">
          <%= f.label :name_cont %>
          <%= f.search_field :name_cont, class: 'form-control' %>
        </div>

        <div class="form-group">
          <%= f.label :created_at_gteq %>
          <%= f.search_field :created_at_gteq, class: 'form-control' %>
        </div>

        <div class="form-group" style="margin-top: 28px;">
          <%= f.search_field :created_at_lteq, class: 'form-control' %>
        </div>

        <%= f.submit 'Pesquisar', class: 'btn btn-outline-primary', style: "margin-top: 25px;" %>
      </div>
    <% end %>
  </div>
</div>


<div class="card border-dark">
  <div class="card-body">
    <table class="table table-striped table-head-bg-black">
      <thead class='table-dark'>
        <tr>
          <th><%= Product.human_attribute_name :name %></th>
          <th><%= Product.human_attribute_name :price_cents %></th>
          <th><%= Product.human_attribute_name :discount %></th>
          <th><%= Product.human_attribute_name :price_with_discount %></th>
          <th><%= Product.human_attribute_name :created_at %></th>
          <th><%= Product.human_attribute_name :visible %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <%= render product %>
        <% end %>
      </tbody>
    </table>

    <%= paginate @products %>
  </div>
</div>
