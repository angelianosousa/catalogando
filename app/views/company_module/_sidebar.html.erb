<!-- Sidebar -->
<div class="sidebar sidebar-style-2" data-background-color="dark">

  <div class="sidebar-logo">
    <!-- Logo Header -->
    <div class="logo-header" data-background-color="dark">
      
      <h4 class='text-white'><%= current_company.name.upcase %></h4>

      <div class="nav-toggle">
        <button class="btn btn-toggle toggle-sidebar">
          <i class="gg-menu-right"></i>
        </button>
        <button class="btn btn-toggle sidenav-toggler">
          <i class="gg-menu-left"></i>
        </button>
      </div>
      <button class="topbar-toggler more">
        <i class="gg-more-vertical-alt"></i>
      </button>
    </div>
    <!-- End Logo Header -->
  </div>

  <div class="sidebar-wrapper scrollbar scrollbar-inner">
    <div class="sidebar-content">
      <ul class="nav nav-secondary">
        <li class="nav-item <%= controller_name == 'dashboard' ? 'active' : '' %>">
          <%= link_to company_dashboard_index_path do %>
            <%= fa_icon "area-chart" %>
            
            <p><%= t('.dashboard') %></p>
          <% end %>
        </li>

        <li class="nav-section">
          <span class="sidebar-mini-icon">
            <i class="fa fa-ellipsis-h"></i>
          </span>

          <h4 class="text-section"><%= t('.menu') %></h4>
        </li>

        <li class="nav-item submenu <%= ['products', 'categories', 'stocks'].include?(controller_name) ? 'active' : '' %>">
          <a data-bs-toggle="collapse" href="#entity_geral">
            <%= fa_icon "th-list" %>
            <p><%= t('.geral') %></p>
            <span class="caret"></span>
          </a>

          <div class="collapse <%= ['products', 'categories', 'stocks'].include?(controller_name) ? 'show' : '' %>" id='entity_geral'>
            <ul class="nav nav-collapse">
              <li>
                <%= link_to '#' do %>
                  <span class="sub-item"><%= t('.products') %></span>
                <% end %>
              </li>
              <li>
                <%= link_to '#' do %>
                  <span class="sub-item"><%= t('.categories') %></span>
                <% end %>
              </li>
            </ul>
          </div>
        </li>

        <li class="nav-item submenu <%= ['orders'].include?(controller_name) ? 'active' : '' %>">
          <a data-bs-toggle="collapse" href="#orders_box">
            <%= fa_icon "shopping-cart" %>
            <p><%= t('.cashier') %></p>
            <span class="caret"></span>
          </a>

          <div class="collapse" id='orders_box'>
            <ul class="nav nav-collapse">
              <li class="<%= controller_name == 'orders' ? 'active' : '' %>">
                <%= link_to '#' do %>
                  <span class="sub-item"><%= t('.orders') %></span>
                <% end %>
              </li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </div>
</div>
<!-- End Sidebar -->
